# Copy to .env and adjust. Every setting is optional.

# Where the database, encrypted keys, token caches and FIT files are stored.
# GD_DATA_DIR=./data

# Address and port. 0.0.0.0 lets phones/laptops on your home network connect.
# GD_HOST=0.0.0.0
# GD_PORT=8000

# Background sync interval in minutes (0 = only sync when "Sync now" is pressed).
# GD_SYNC_INTERVAL_MINUTES=180

# How far back the first sync for a new person goes.
# GD_DEFAULT_HISTORY_DAYS=365

# Encryption key for stored Garmin API keys. If unset, one is generated in
# data/secrets/master.key on first run - back that file up with the database.
# GD_SECRET_KEY=

# Set to true only if you serve the dashboard over HTTPS (e.g. behind a reverse proxy).
# GD_SECURE_COOKIES=false
